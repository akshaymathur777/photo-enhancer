{
  "schema": 2,
  "host_capabilities": ["llm.image", "llm.image.edit", "host.upload"],
  "required_executas": [
    {
      "tool_id": "bundled:photo-enhancer",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ],
  "optional_executas": [
    {
      "tool_id": "bundled:photo-enhancer-local",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ],
  "tags": ["photo-enhancer", "image", "edit", "background-removal"],
  "system_prompt_addendum": "Reliclear is installed. Open the App UI with open_app_view (view: main) so the user can upload and process, or call enhance_photo / remove_background with an existing image URL. This release ships Enhance + Remove background only — do not offer remove_object. Prefer App UI for local file upload. If host image.edit fails, the UI falls back to local classical enhance / rembg. Explain which track you used.",
  "user_message_prefix_template": "[Reliclear] {user_message}",
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Reliclear",
        "default": true,
        "default_size": { "w": 920, "h": 640 },
        "min_size": { "w": 420, "h": 360 },
        "max_size": { "w": 1440, "h": 900 },
        "single_instance": true,
        "summary_template": "Reliclear · {mode}"
      }
    ],
    "host_api": {
      "tools": ["bundled:photo-enhancer", "bundled:photo-enhancer-local"],
      "storage": ["get", "set", "delete", "list"],
      "window": ["set_title", "ready"],
      "image": ["generate", "edit", "resign"],
      "upload": ["inline", "negotiate", "confirm"],
      "llm": ["catalog"]
    },
    "csp_overrides": {
      "img-src": ["https:", "data:", "blob:"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
