# Photo Enhancer chat configuration
#
# By default the chat is fully offline and privacy-first:
#   1. Local Ollama (if installed & reachable)  -> conversational, on-device
#   2. OpenAI (only if OPENAI_API_KEY is set)    -> opt-in, cloud
#   3. Built-in rule-based parser                -> always-on fallback
#
# Nothing here is required. With no config the app uses the rule-based engine
# (and Ollama automatically if it happens to be running).

# --- Server (optional) ---
# HOST=127.0.0.1
# PORT=8000

# --- Local, on-device LLM via Ollama (optional, recommended, fully offline) ---
# Install Ollama (https://ollama.com), keep it running, then pull a chat model:
#   ollama pull llama3.2:3b
# Any pulled model works (auto picks first available). To pin a specific model:
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# --- Force a specific chat backend (optional) ---
# auto (default) | rules | ollama | openai
# CHAT_BACKEND=auto

# --- Cloud LLM via OpenAI (optional, opt-in, requires internet) ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model cache (optional override) ---
# Default: %APPDATA%\PhotoEnhancer\models on Windows
# PHOTO_ENHANCER_MODEL_DIR=C:\path\to\models

# --- Upscale output limit (optional) ---
# Maximum output size in megapixels for Real-ESRGAN upscale (50–400).
# Default: 150 MP. Also configurable in the app UI (Upscale tool or Models panel).
# Saved per-user to %APPDATA%\PhotoEnhancer\settings.json when changed in the UI.
# MAX_OUTPUT_MP=150
